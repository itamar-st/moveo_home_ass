# Database (MySQL 8.0 via asyncmy)
DATABASE_URL=mysql+asyncmy://wria:wria@localhost:3306/wria

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,baidu/ernie-5.5-flash-preview:free
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Weather Risk Intelligence Agent

# NWS API (User-Agent is required by api.weather.gov)
NWS_USER_AGENT=WeatherRiskAgent (you@example.com)

# Admin & Alerts
ADMIN_TOKEN=change-me-admin-token
ALERT_WEBHOOK_URL=
ALERT_SCORE_DELTA=10

# Scheduler
SCHEDULER_ENABLED=true
NWS_REFRESH_MINUTES=30
WEATHER_REFRESH_CRON=0 6 * * *

# API & Rate Limiting
CORS_ORIGINS=http://localhost:5173
CHAT_RATE_LIMIT_PER_MIN=10
MAX_AGENT_STEPS=6

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
